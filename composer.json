{
    "name": "innoboxrr/zoom-sdk",
    "description": "Crea, consulta, actualiza y elimina reuniones de Zoom desde Laravel con la API Server-to-Server OAuth.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Innoboxrr\\ZoomSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Innoboxrr\\ZoomSdk\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Homero Raul",
            "email": "h.raulvc@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.3",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "innoboxrr/larapack-generator": "^9.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innoboxrr\\ZoomSdk\\Providers\\AppServiceProvider",
                "Innoboxrr\\ZoomSdk\\Providers\\AuthServiceProvider",
                "Innoboxrr\\ZoomSdk\\Providers\\EventServiceProvider",
                "Innoboxrr\\ZoomSdk\\Providers\\RouteServiceProvider"
            ],
            "aliases": {
                "Zoom": "Innoboxrr\\ZoomSdk\\Facades\\Zoom"
            }
        }
    }
}
